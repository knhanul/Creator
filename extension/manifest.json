{
  "manifest_version": 3,
  "name": "GOMO Gemini Connector",
  "version": "0.2.9",
  "description": "Connects GOMO Create to Gemini web via Native Messaging",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "gomo-sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "gemini-selectors.js",
        "gemini-dom.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GOMO Gemini Connector"
  }
}
