{
  "name": "gomo-creation-studio",
  "private": true,
  "version": "0.1.0",
  "description": "\uace0\ubaa8 \ubbf8\ub514\uc5b4\uacf5\ubc29 \u2014 \uace0\ubaa8 \ucc3d\uc791\uc2e4 (AI \ucf58\ud150\uce20 \uae30\ud68d \ubc0f \ubbf8\ub514\uc5b4 \uc81c\uc791)",
  "main": "./out/main/index.js",
  "author": "GOMO Media Workshop",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "test": "node scripts/run-tests.mjs && node scripts/test-job-queue.mjs && node scripts/test-gemini-automation.mjs && node scripts/test-gemini-dom.mjs && node src/renderer/theme/theme.test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "native:register": "node native-host/register.mjs register",
    "native:unregister": "node native-host/register.mjs unregister",
    "native:check": "node native-host/register.mjs check",
    "test:gemini": "node scripts/test-gemini-automation.mjs && node scripts/test-gemini-dom.mjs",
    "check:extension": "node scripts/check-extension.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.gomoworkshop.creator",
    "productName": "\uace0\ubaa8 \ucc3d\uc791\uc2e4",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "resources/app.png",
        "to": "app.png"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
